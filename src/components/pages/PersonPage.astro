---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../lib/site.ts';
import { t, type Locale } from '../../lib/i18n.ts';

interface Props {
  locale: Locale;
  person: CollectionEntry<'people'>;
}
const { locale, person } = Astro.props;
const s = t(locale);
const { Content } = await render(person);
const data = person.data as Record<string, unknown>;
---
<BaseLayout
  title={data.name as string}
  description={s('personInLab', {
    name: data.name as string,
    rank: data.rank as string,
    lab: site.labName,
  })}
  locale={locale}
  path={`/team/${person.id}`}
>
  <h1>{data.name}</h1>
  <p class="muted">{data.rank}{data.pronouns ? ` · ${data.pronouns}` : ''}</p>

  {data.placeholder && (
    <p class="notice"><strong>{s('placeholderEntry')}</strong> {s('notARealPerson')}</p>
  )}

  <Content />

  <ul class="social" style="margin-block-start: var(--space-m);">
    {data.email && <li><a href={`mailto:${data.email}`}>{data.email as string}</a></li>}
    {data.orcid && <li><a href={`https://orcid.org/${data.orcid}`} rel="noopener">ORCID</a></li>}
    {data.github && <li><a href={`https://github.com/${data.github}`} rel="noopener">GitHub</a></li>}
    {data.website && <li><a href={data.website as string} rel="noopener">{s('websiteLabel')}</a></li>}
  </ul>
</BaseLayout>
