---
/**
 * Photographs, from a folder the owner already uses.
 *
 * The data here is a fixture shaped exactly like `@palebluebytes/cms` returns,
 * so going live is a one-line swap for `await fetchPhotos({ folderId, auth })`
 * and nothing else on the page changes.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import fixtures from '../../data/fixtures/gallery.json' with { type: 'json' };
import { galleryState, type GalleryPhoto } from '../../lib/gallery.ts';
import { url } from '../../lib/paths.ts';
import { t, type Locale } from '../../lib/i18n.ts';

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = t(locale);

const state = galleryState(fixtures as GalleryPhoto[]);
---
<BaseLayout
  title={s('navGallery')}
  description={s('galleryDescription')}
  locale={locale}
  path="/gallery"
>
  <h1>{s('navGallery')}</h1>

  {state.kind === 'empty' ? (
    <p class="notice"><strong>{s('galleryUnavailable')}</strong> {state.warning}</p>
  ) : (
    <ul class="gallery">
      {state.photos.map((photo) => (
        <li>
          {photo.url
            ? <img src={url(photo.url)} alt={photo.caption} width={photo.width ?? undefined} height={photo.height ?? undefined} loading="lazy" />
            : (
              <div class="gallery__item" style={`aspect-ratio: ${photo.ratio};`}>
                <span>{photo.caption}<br /><span class="small">{photo.width}×{photo.height}</span></span>
              </div>
            )}
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
