---
/**
 * The people, grouped by rank rather than listed flat.
 *
 * Seniority drives the order because the ranks are declared in that order in
 * the schema, not because anyone sorted by it here: `PERSON_RANKS` is the one
 * place the order lives, and the in-page index is built from the same groups
 * the page renders, so it cannot point at a heading that is not there.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PeopleGrid from '../PeopleGrid.astro';
import SectionIndex from '../SectionIndex.astro';
import { PERSON_RANKS } from '../../schema/collections.ts';
import { site } from '../../lib/site.ts';
import { plural, t, type Locale } from '../../lib/i18n.ts';

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = t(locale);

const people = await getCollection('people');

/** Rank names become the anchors the in-page index points at. */
const anchor = (rank: string) => rank.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const groups = PERSON_RANKS.map((rank) => ({
  rank,
  id: anchor(rank),
  // Alumni are part of the record but not the answer to "who is in this group":
  // they are folded away so the people currently here are not read past. This
  // is a ranking of the content rather than a look, so every design gets it.
  collapsed: rank === 'Alumni',
  members: people
    .filter((person) => person.data.rank === rank)
    .sort((a, b) => (a.data.order as number) - (b.data.order as number)),
})).filter((group) => group.members.length > 0);

const sections: [string, string][] = groups.map((group) => [group.id, group.rank]);
---
<BaseLayout
  title={s('navTeam')}
  description={s('teamDescription', { lab: site.labName })}
  locale={locale}
  path="/team"
>
  <h1>{s('navTeam')}</h1>
  <SectionIndex sections={sections} heading={s('positions')} />
  <p class="notice">
    <strong>{s('demoContent')}</strong> {s('teamPlaceholderNote')}
  </p>

  {groups.map((group) => (
    <section class="people" id={group.id}>
      <h2>{group.rank}</h2>
      {group.collapsed ? (
        <details class="people__fold">
          <summary class="people__summary">
            {s(`formerMembers${plural(group.members.length)}`, { n: group.members.length })}
          </summary>
          <PeopleGrid members={group.members} />
        </details>
      ) : (
        <PeopleGrid members={group.members} />
      )}
    </section>
  ))}
</BaseLayout>
