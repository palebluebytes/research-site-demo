---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/paths.ts';
import { formatDate, type Locale } from '../../lib/i18n.ts';

interface Props {
  locale: Locale;
  item: CollectionEntry<'news'>;
}
const { locale, item } = Astro.props;
const { Content } = await render(item);
const date = item.data.date as Date;
---
<BaseLayout
  title={item.data.title as string}
  description={(item.data.summary as string | undefined) ?? undefined}
  locale={locale}
  path={`/news/${item.id}`}
>
  <h1>{item.data.title}</h1>
  <p class="dateline"><time datetime={date.toISOString()}>{formatDate(locale, date)}</time></p>
  {item.data.image && <img src={url(item.data.image as string)} alt={(item.data.imageAlt as string | undefined) ?? ''} width="1200" height="800" />}
  <Content />
</BaseLayout>
