---
/**
 * The publications page, in one language.
 *
 * The record itself is language-neutral - a DOI, a journal name, a list of
 * authors - so what gets translated here is the apparatus around it: the two
 * section headings, the synchronisation line, and the date, which is the one
 * value that has to be *formatted* per locale rather than looked up.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationList from '../PublicationList.astro';
import SectionIndex from '../SectionIndex.astro';
import { normalisePublications, type Snapshot } from '../../lib/orcid.ts';
import snapshot from '../../data/orcid-snapshot.json' with { type: 'json' };
import { formatDate, plural, t, type Locale } from '../../lib/i18n.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);

const { publications, syncedAt } = normalisePublications(snapshot as Snapshot);

/*
 * The ORCID iD comes off the snapshot rather than site.json, because this
 * notice names the record the list below was actually built from. Reading it
 * from the profile instead would let the two drift: change the iD in the CMS
 * and the page would credit a record it had never synced.
 */
const orcidId = (snapshot as Snapshot).orcid;

const highlightEntries = (await getCollection('highlights')).sort(
  (a, b) => (a.data.order as number) - (b.data.order as number),
);
const notes = Object.fromEntries(
  highlightEntries.flatMap((entry) =>
    entry.data.note ? [[entry.data.doi as string, entry.data.note as string]] : [],
  ),
);
const highlightDois = highlightEntries.map((entry) => entry.data.doi as string);

const byDoi = new Map(publications.flatMap((p) => (p.doi ? [[p.doi, p]] : [])));
const highlights = highlightDois.flatMap((doi) => byDoi.get(doi) ?? []);
const missingHighlights = highlightDois.filter((doi) => !byDoi.has(doi));

/*
 * Every work appears once, and the selected list wins.
 *
 * Two exclusions, for two different reasons. A highlighted paper is already
 * set out above with a note saying why it matters, and printing it again a
 * screen later says the record has two of it. And a preprint whose published
 * version is also on the record is the same work twice in ORCID's data rather
 * than on this page: the published version is the one that carries the
 * citation, so the preprint is dropped rather than given a section of its own
 * to sit in.
 */
const selectedDois = new Set(highlightDois);
const rest = publications.filter(
  (p) => p.supersededBy === null && !(p.doi && selectedDois.has(p.doi)),
);

/*
 * What the second list is called depends on whether there is a first one. With
 * selected papers above it, it holds what is left and cannot be called all of
 * them; without, it is the whole record. The highlights are theirs to edit, so
 * both states are reachable from the CMS - which is why both names are in the
 * catalogue rather than one of them being built by appending a word.
 */
const restHeading = highlights.length > 0 ? s('otherPublications') : s('allPublications');

const synced = formatDate(locale, new Date(syncedAt));

// The index of this page, built from the same conditions that decide whether
// each section is rendered, so it can never point at a heading that is not
// there.
const sections: [string, string][] = [
  ...(highlights.length > 0
    ? [['selected', s('selectedPublications')] as [string, string]]
    : []),
  ['rest', restHeading],
];

const n = missingHighlights.length;
const variant = plural(n);
---
<BaseLayout
  title={s('publicationsTitle')}
  description={s('publicationsDescription')}
  locale={locale}
  path="/publications"
>
  <h1>{s('publicationsTitle')}</h1>
  <SectionIndex sections={sections} heading={s('onThisPage')} />

  <p class="muted small">
    {s('lastUpdatedFrom')} <a href={`https://orcid.org/${orcidId}`} rel="noopener">ORCID</a>
    {' '}{s('lastUpdatedOn')} {synced}.
  </p>

  {/*
    Works absent from the ORCID record are not named here. That list is a
    to-do list for the owner and reads as an apology to everyone else, so it
    lives on /how-this-works, which is the page written for them. See the "Why
    some of your papers are missing" section there.

    This notice is the other thing, and it stays: a highlighted DOI that is not
    on the record is a broken entry in the owner's own curation, and the paper
    it names is silently absent from the page above until they fix it.

    The sentence is split in two across the catalogue rather than assembled
    from fragments, because the bold clause and the rest have to be ordered by
    the translator and not by this template. Both halves carry `{n}` and
    `{dois}`, and test/i18n.test.ts fails if a translation drops either.
  */}
  {n > 0 && (
    <p class="notice">
      <strong>{s(`missingHighlightsLead${variant}`, { n })}</strong>
      {' '}{s(`missingHighlightsRest${variant}`, { dois: missingHighlights.join(', ') })}
    </p>
  )}

  {highlights.length > 0 && (
    <section id="selected">
      <h2>{s('selectedPublications')}</h2>
      <PublicationList publications={highlights} notes={notes} locale={locale} />
    </section>
  )}

  <section id="rest">
    <h2>{restHeading}</h2>
    <PublicationList publications={rest} locale={locale} />
  </section>
</BaseLayout>
