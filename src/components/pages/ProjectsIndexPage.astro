---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/paths.ts';
import { localePath, t, type Locale } from '../../lib/i18n.ts';

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = t(locale);

const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.order as number) - (b.data.order as number),
);
---
<BaseLayout
  title={s('navProjects')}
  description={s('projectsDescription')}
  locale={locale}
  path="/projects"
>
  <h1>{s('navProjects')}</h1>

  <ul class="cards">
    {projects.map((project) => (
      <li class="card">
        {project.data.image && (
          <img
            src={url(project.data.image as string)}
            alt={(project.data.imageAlt as string | undefined) ?? ''}
            width="600"
            height="400"
          />
        )}
        <h2 class="card__title">
          <a href={url(localePath(locale, `/projects/${project.id}`))}>{project.data.title}</a>
        </h2>
        <p>{project.data.summary}</p>
        {project.data.funder && <p class="small muted">{s('fundedBy', { funder: project.data.funder as string })}</p>}
      </li>
    ))}
  </ul>
</BaseLayout>
