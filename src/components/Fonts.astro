---
/**
 * Every design's faces, declared and the default design's preloaded.
 *
 * Written here rather than imported from each `@fontsource-variable` package's
 * own stylesheet, for two reasons that between them are the whole fix for the
 * flash of unstyled text.
 *
 * **The request starts at the first byte of the head.** Fontsource's CSS
 * arrives inside the bundled stylesheet, so the browser could not learn a font
 * existed until it had fetched and parsed that file: HTML, then CSS, then font,
 * one after the other. Declaring the faces inline and preloading the one every
 * page needs collapses that chain - the font is in flight alongside the
 * stylesheet rather than behind it.
 *
 * **`font-display: optional`, not `swap`.** `swap` is a promise to repaint the
 * page in a different typeface whenever the font turns up, which is the flash
 * itself. `optional` gives the font about 100ms to arrive and then stops
 * offering: either the first paint is the real face, or the page is set in the
 * fallback and stays there, and the font is used from the next navigation on.
 * Nothing reflows either way. Each design's fallback chain in `lib/themes.ts`
 * was chosen for exactly this moment, which is why Feature's stays serif the
 * whole way down.
 *
 * **Only Archivo is preloaded**, and that is the one decision three designs
 * forced. The other three families belong to Feature and Instrument, which a
 * reader reaches only by choosing them in the switcher; preloading them would
 * charge every reader for a choice most never make. Switching therefore costs
 * one font fetch, which is the right place to put that cost - the reader asked
 * for it, and `optional` means the switch paints immediately either way.
 *
 * The URLs come from Vite, which hashes each file and prefixes the site's base
 * path, so they stay correct under a GitHub Pages project path and can be
 * cached forever.
 */
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import archivoLatinExt from '@fontsource-variable/archivo/files/archivo-latin-ext-wght-normal.woff2?url';
import archivoLatinItalic from '@fontsource-variable/archivo/files/archivo-latin-wght-italic.woff2?url';
import archivoLatinExtItalic from '@fontsource-variable/archivo/files/archivo-latin-ext-wght-italic.woff2?url';

/*
 * Fraunces from its optical-size build, not its weight-only one. One file then
 * covers a cover line and a caption and draws each for the size it is set at;
 * `font-optical-sizing: auto` is the browser default, so this needs no
 * `font-variation-settings` anywhere.
 */
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import frauncesLatinExt from '@fontsource-variable/fraunces/files/fraunces-latin-ext-opsz-normal.woff2?url';
import frauncesLatinItalic from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-italic.woff2?url';
import frauncesLatinExtItalic from '@fontsource-variable/fraunces/files/fraunces-latin-ext-opsz-italic.woff2?url';

import instrumentLatin from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import instrumentLatinExt from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-ext-wght-normal.woff2?url';
import instrumentLatinItalic from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-italic.woff2?url';
import instrumentLatinExtItalic from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-ext-wght-italic.woff2?url';

import plexLatin from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import plexLatinExt from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-ext-wght-normal.woff2?url';
import plexLatinItalic from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-italic.woff2?url';
import plexLatinExtItalic from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-ext-wght-italic.woff2?url';

import monoLatin from '@fontsource-variable/source-code-pro/files/source-code-pro-latin-wght-normal.woff2?url';
import monoLatinExt from '@fontsource-variable/source-code-pro/files/source-code-pro-latin-ext-wght-normal.woff2?url';
import monoLatinItalic from '@fontsource-variable/source-code-pro/files/source-code-pro-latin-wght-italic.woff2?url';
import monoLatinExtItalic from '@fontsource-variable/source-code-pro/files/source-code-pro-latin-ext-wght-italic.woff2?url';

/*
 * The subsets, with the ranges Fontsource ships. Latin-ext earns its place on
 * the author lists and the switcher's own "Français" and "Español"; italic
 * earns it in the prose. Vietnamese is dropped: `unicode-range` means no page
 * here would ever fetch it, and shipping a file nothing requests is still a
 * file in the deploy - with four families that is four files rather than one.
 */
const LATIN = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT = 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';

/** Weight is a range on every one of these faces, so `font-weight: 550` interpolates on its own. */
const face = (family: string, src: string, style: 'normal' | 'italic', range: string) => `@font-face {
  font-family: '${family}';
  font-style: ${style};
  font-weight: 100 900;
  font-display: optional;
  src: url(${src}) format('woff2-variations');
  unicode-range: ${range};
}`;

/** One family's four subsets, in the order Fontsource names them. */
const family = (
  name: string,
  [latin, latinExt, latinItalic, latinExtItalic]: [string, string, string, string],
) =>
  [
    face(name, latin, 'normal', LATIN),
    face(name, latinExt, 'normal', LATIN_EXT),
    face(name, latinItalic, 'italic', LATIN),
    face(name, latinExtItalic, 'italic', LATIN_EXT),
  ].join('\n');

const faces = [
  family('Archivo Variable', [archivoLatin, archivoLatinExt, archivoLatinItalic, archivoLatinExtItalic]),
  family('Fraunces Variable', [frauncesLatin, frauncesLatinExt, frauncesLatinItalic, frauncesLatinExtItalic]),
  family('Instrument Sans Variable', [instrumentLatin, instrumentLatinExt, instrumentLatinItalic, instrumentLatinExtItalic]),
  family('IBM Plex Sans Variable', [plexLatin, plexLatinExt, plexLatinItalic, plexLatinExtItalic]),
  family('Source Code Pro Variable', [monoLatin, monoLatinExt, monoLatinItalic, monoLatinExtItalic]),
].join('\n');
---
{/*
  Only Archivo's roman latin subset is preloaded: it is the face the default
  design sets its body text in. Everything else is conditional - on a character
  appearing, or on the reader switching design - and preloading a file a page
  may never ask for is how a preload starts costing more than it saves.
  `crossorigin` is not optional even same-origin: fonts are fetched in CORS
  mode, and without it the browser preloads one copy and then fetches a second.
*/}
<link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
<style is:global set:html={faces}></style>
